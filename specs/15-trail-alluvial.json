{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 700,
  "height": 360,
  "padding": 5,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "description": "Two-stage parallel sets of surface and equal-width 50 km length bands for 14 selected listings. Width counts listings; labels are outside ribbons. Partly open status is marked on Figure 2.",
  "signals": [
    {
      "name": "left",
      "update": "width<500 ? 83 : 145"
    },
    {
      "name": "right",
      "update": "width-(width<500 ? 88 : 145)"
    },
    {
      "name": "unit",
      "update": "(height-55)/16.7"
    },
    {
      "name": "hoverFlow",
      "value": -1,
      "on": [
        {
          "events": "@ribbons:mouseover",
          "update": "datum.id"
        },
        {
          "events": "@ribbons:mouseout",
          "update": "-1"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "flows",
      "values": [
        {
          "cats": [
            "Sealed",
            "0–49 km"
          ],
          "surface": "Sealed",
          "count": 4,
          "names": "Coast to Vines; NW Tasmanian Coastal Pathway; Barossa; Tumbarumba",
          "p0": 0,
          "p1": 0,
          "id": 0
        },
        {
          "cats": [
            "Sealed",
            "100–149 km"
          ],
          "surface": "Sealed",
          "count": 1,
          "names": "Murray to Mountains",
          "p0": 4,
          "p1": 13.8,
          "id": 1
        },
        {
          "cats": [
            "Unsealed",
            "0–49 km"
          ],
          "surface": "Unsealed",
          "count": 1,
          "names": "North-East Tasmania",
          "p0": 5.9,
          "p1": 4,
          "id": 2
        },
        {
          "cats": [
            "Unsealed",
            "50–99 km"
          ],
          "surface": "Unsealed",
          "count": 3,
          "names": "Denmark – Nornalup Heritage; Railway Reserves; Riesling and Rattler Trails",
          "p0": 6.9,
          "p1": 6.9,
          "id": 3
        },
        {
          "cats": [
            "Mixed",
            "0–49 km"
          ],
          "surface": "Mixed",
          "count": 1,
          "names": "Warburton/Yarra Valley Trail",
          "p0": 10.8,
          "p1": 5,
          "id": 4
        },
        {
          "cats": [
            "Mixed",
            "50–99 km"
          ],
          "surface": "Mixed",
          "count": 3,
          "names": "East Gippsland; Kilkivan – Kingaroy; Northern Rivers",
          "p0": 11.8,
          "p1": 9.9,
          "id": 5
        },
        {
          "cats": [
            "Mixed",
            "150–199 km"
          ],
          "surface": "Mixed",
          "count": 1,
          "names": "Brisbane Valley",
          "p0": 14.8,
          "p1": 15.700000000000001,
          "id": 6
        }
      ]
    },
    {
      "name": "nodes",
      "values": [
        {
          "axis": 0,
          "cat": "Sealed",
          "count": 5,
          "start": 0,
          "end": 5
        },
        {
          "axis": 0,
          "cat": "Unsealed",
          "count": 4,
          "start": 5.9,
          "end": 9.9
        },
        {
          "axis": 0,
          "cat": "Mixed",
          "count": 5,
          "start": 10.8,
          "end": 15.8
        },
        {
          "axis": 1,
          "cat": "0–49 km",
          "count": 6,
          "start": 0,
          "end": 6
        },
        {
          "axis": 1,
          "cat": "50–99 km",
          "count": 6,
          "start": 6.9,
          "end": 12.9
        },
        {
          "axis": 1,
          "cat": "100–149 km",
          "count": 1,
          "start": 13.8,
          "end": 14.8
        },
        {
          "axis": 1,
          "cat": "150–199 km",
          "count": 1,
          "start": 15.700000000000001,
          "end": 16.700000000000003
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "surface",
      "type": "ordinal",
      "domain": [
        "Sealed",
        "Mixed",
        "Unsealed"
      ],
      "range": [
        "#245646",
        "#a4482f",
        "#806926"
      ]
    }
  ],
  "marks": [
    {
      "name": "ribbons",
      "type": "path",
      "from": {
        "data": "flows"
      },
      "encode": {
        "update": {
          "path": {
            "signal": "'M'+left+','+(36+unit*datum.p0)+'C'+((left+right)/2)+','+(36+unit*datum.p0)+' '+((left+right)/2)+','+(36+unit*datum.p1)+' '+right+','+(36+unit*datum.p1)+'L'+right+','+(36+unit*(datum.p1+datum.count))+'C'+((left+right)/2)+','+(36+unit*(datum.p1+datum.count))+' '+((left+right)/2)+','+(36+unit*(datum.p0+datum.count))+' '+left+','+(36+unit*(datum.p0+datum.count))+'Z'"
          },
          "fill": {
            "scale": "surface",
            "field": "surface"
          },
          "fillOpacity": {
            "signal": "hoverFlow===-1 ? .8 : hoverFlow===datum.id ? 1 : .12"
          },
          "stroke": {
            "value": "#f7f5ed"
          },
          "strokeWidth": {
            "value": 1.2
          },
          "tooltip": {
            "signal": "{'Surface':datum.cats[0],'Length band':datum.cats[1],'Listings':datum.count,'Trails':datum.names}"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.axis===0 ? left-6 : right"
          },
          "width": {
            "value": 6
          },
          "y": {
            "signal": "36+unit*datum.start"
          },
          "y2": {
            "signal": "36+unit*datum.end"
          },
          "fill": {
            "value": "#203b32"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.axis===0 ? left-13 : right+13"
          },
          "y": {
            "signal": "29+unit*(datum.start+datum.end)/2"
          },
          "text": {
            "signal": "[datum.cat,datum.count+(datum.count===1 ? ' listing' : ' listings')]"
          },
          "align": {
            "signal": "datum.axis===0 ? 'right' : 'left'"
          },
          "lineHeight": {
            "value": 14
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#203b32"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "left-13"
          },
          "y": {
            "value": 15
          },
          "align": {
            "value": "right"
          },
          "text": {
            "value": "Surface"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#203b32"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "right+13"
          },
          "y": {
            "value": 15
          },
          "align": {
            "value": "left"
          },
          "text": {
            "value": "Length band"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#203b32"
          }
        }
      }
    }
  ]
}