  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 27,
        "cornerRadius": 2
      },
      "encoding": {
        "y": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "sort": "ascending"
        },
        "x": {
          "field": "rate",
          "type": "quantitative",
          "stack": "zero",
          "title": "Share of established riders (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "labelExpr": "datum.value + '%'"
          }
        },
        "color": {
          "field": "change",
          "scale": {
            "domain": [
              "Less often",
              "About the same",
              "More often"
            ],
            "range": [
              "#a4482f",
              "#d9ddc9",
              "#245646"
            ]
          },
          "title": null
        },
        "order": {
          "field": "order"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "change",
            "type": "nominal",
            "title": "Riding frequency"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Share (%)",
            "format": ".1f"
          }
        ]
      }
    },
