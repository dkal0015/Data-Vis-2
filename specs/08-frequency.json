{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#526354",
      "titleColor": "#203b32",
      "gridColor": "#e1e4d9",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
