      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "km",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": "squarify",
          "ratio": 1.3,
          "round": true,
          "paddingInner": 3,
          "paddingOuter": 5,
          "paddingTop": 25,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth===2"
        }
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth===1"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "surface",
      "type": "ordinal",
      "domain": [
        "Sealed",
        "Mixed",
        "Unsealed"
      ],
      "range": [
        "#245646",
        "#a4482f",
        "#806926"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "surface",
            "field": "surface_group"
          },
          "stroke": {
            "value": "#f7f5ed"
          },
          "fillOpacity": {
            "signal": "highlight==='' || datum.short_name===highlight ? 1 : .25"
          },
          "tooltip": {
            "signal": "{'Trail':datum.name,'Listed length (km)':datum.km,'Surface':datum.surface_group,'State':datum.state,'Status':datum.status}"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0+7"
          },
          "y": {
            "signal": "datum.y0+15"
          },
          "text": {
            "signal": "datum.name+' · '+format(datum.listedKm,',')+' listed km'"
          },
          "fill": {
            "value": "#203b32"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "limit": {
            "signal": "datum.x1-datum.x0-12"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0+7"
          },
          "y": {
            "signal": "datum.y0+17"
          },
          "text": {
            "field": "short_name"
          },
          "fill": {
            "value": "#f7f5ed"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "limit": {
            "signal": "max(0,datum.x1-datum.x0-14)"
          },
          "opacity": {
            "signal": "datum.x1-datum.x0>75 && datum.y1-datum.y0>38 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0+7"
          },
          "y": {
            "signal": "datum.y0+34"
          },
          "text": {
            "signal": "datum.km+' km'"
          },
          "fill": {
            "value": "#f7f5ed"
          },
          "fontSize": {
            "value": 12
          },
          "limit": {
            "signal": "max(0,datum.x1-datum.x0-14)"
          },
          "opacity": {
            "signal": "datum.x1-datum.x0>42 && datum.y1-datum.y0>38 ? 1 : 0"
          }
        }
      }
    }
  ]
}